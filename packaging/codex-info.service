# Install with: bash scripts/install_systemd_recorder.sh
[Unit]
Description=Codex Info daemon and loopback REST service
After=default.target
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/codex_info --port 8787
Restart=on-failure
RestartSec=15s
KillSignal=SIGTERM
TimeoutStopSec=20s
Environment=CODEX_INFO_DAEMON_INTERVAL_SECS=60
# The user-installed Codex launcher is authoritative. Without this explicit
# order systemd can silently select an older /usr/local installation.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
NoNewPrivileges=true
# Do not enable PrivateTmp here: its mount namespace makes /proc/*/exe and
# /proc/*/fd of the user's live Codex processes unreadable, which would force
# the REST Threads snapshot to a false zero.

[Install]
WantedBy=default.target
