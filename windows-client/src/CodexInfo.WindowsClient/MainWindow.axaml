<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CodexInfo.WindowsClient.ViewModels"
        x:Class="CodexInfo.WindowsClient.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="900"
        Height="720"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        Title="Codex Info Monitor"
        FontFamily="{StaticResource JapaneseFont}"
        Background="#0E141E"
        Foreground="#E9EFF8">
  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#151F2D" />
      <Setter Property="BorderBrush" Value="#263548" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#A8B7CA" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Foreground" Value="#F2F6FC" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.metric-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#A8B7CA" />
    </Style>
    <Style Selector="TextBlock.metric-value">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="#F2F6FC" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Button.refresh">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="#294968" />
      <Setter Property="BorderBrush" Value="#47769F" />
      <Setter Property="Foreground" Value="#F2F6FC" />
    </Style>
    <Style Selector="Button.refresh:pointerover">
      <Setter Property="Background" Value="#356087" />
    </Style>
    <Style Selector="Button.refresh:disabled">
      <Setter Property="Background" Value="#1D2A38" />
      <Setter Property="BorderBrush" Value="#2A3A4B" />
      <Setter Property="Foreground" Value="#8EA1B5" />
    </Style>
    <Style Selector="Button.command">
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="MinWidth" Value="72" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="#18283A" />
      <Setter Property="BorderBrush" Value="#304A63" />
      <Setter Property="Foreground" Value="#EAF2FB" />
    </Style>
    <Style Selector="Button.command:pointerover">
      <Setter Property="Background" Value="#24415E" />
      <Setter Property="BorderBrush" Value="#5EA7E5" />
    </Style>
    <Style Selector="Border.app-mark">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="42" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="#1C5D91" />
      <Setter Property="BorderBrush" Value="#5EA7E5" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.window-control">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#A8B7CA" />
    </Style>
    <Style Selector="Button.window-control:pointerover">
      <Setter Property="Background" Value="#263548" />
      <Setter Property="Foreground" Value="#F2F6FC" />
    </Style>
    <Style Selector="Border.models-section">
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.model-card">
      <Setter Property="Background" Value="#111A27" />
      <Setter Property="BorderBrush" Value="#263548" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10" />
    </Style>
  </Window.Styles>

  <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Panel.ZIndex="10" Background="Transparent" PointerPressed="OnTitlePointerPressed">
      <!-- Keep the identity block measurable even when unauthenticated
           actions collapse (error/auth states still need a stable header). -->
      <StackPanel Orientation="Horizontal" Spacing="12" Width="260" MinWidth="260" HorizontalAlignment="Left">
        <Border Classes="app-mark">
          <TextBlock FontSize="22" Foreground="#F2F6FC"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Text="◈" />
        </Border>
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock FontSize="25" FontWeight="SemiBold" Foreground="#E9EFF8" Text="{Binding Texts.UsageStatus}" />
          <TextBlock Classes="label" Foreground="#A8B7CA" Text="{Binding Texts.AppSubtitle}" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
        <Button Classes="command" IsVisible="{Binding IsAuthenticated}" Click="OnOpenGraph" AutomationProperties.Name="{Binding Texts.Graph}" ToolTip.Tip="{Binding Texts.Graph}">
          <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="▥" /><TextBlock Text="{Binding Texts.Graph}" /></StackPanel>
        </Button>
        <Button Classes="command" IsVisible="{Binding IsAuthenticated}" Click="OnOpenThreads" AutomationProperties.Name="{Binding Texts.Threads}" ToolTip.Tip="{Binding Texts.Threads}">
          <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="☷" /><TextBlock Text="{Binding Texts.Threads}" /></StackPanel>
        </Button>
        <Button Classes="command" Click="OnOpenLegal" AutomationProperties.Name="{Binding Texts.Legal}" ToolTip.Tip="{Binding Texts.Legal}">
          <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="ⓘ" /><TextBlock Text="{Binding Texts.Legal}" /></StackPanel>
        </Button>
        <Button Classes="command" Click="OnOpenSettings" AutomationProperties.Name="{Binding Texts.Settings}" ToolTip.Tip="{Binding Texts.Settings}">
          <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="⚙" /><TextBlock Text="{Binding Texts.Settings}" /></StackPanel>
        </Button>
        <Button Classes="command" AutomationProperties.Name="{Binding Texts.Refresh}"
                Command="{Binding RefreshCommand}"
                IsEnabled="{Binding CanRefresh}"
                ToolTip.Tip="{Binding Texts.Refresh}">
          <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="↻" /><TextBlock Text="{Binding RefreshButtonText}" /></StackPanel>
        </Button>
        <Button Classes="window-control" Click="OnMinimizeWindow" AutomationProperties.Name="{Binding Texts.Minimize}" Content="—" ToolTip.Tip="{Binding Texts.Minimize}" />
        <Button Classes="window-control" Click="OnCloseWindow" AutomationProperties.Name="{Binding Texts.Close}" Content="×" ToolTip.Tip="{Binding Texts.Close}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1"
            Background="{Binding StatusBackground}"
            BorderBrush="{Binding StatusBorder}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="16,12">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <Border Width="10" Height="10" CornerRadius="5" Background="{Binding StatusAccent}" VerticalAlignment="Top" Margin="0,5,0,0" />
        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding StatusTitle}" />
          <TextBlock Classes="label" Text="{Binding StatusDetail}" TextWrapping="Wrap" />
          <Button Classes="refresh"
                  HorizontalAlignment="Left"
                  IsVisible="{Binding IsAuthRequired}"
                  Command="{Binding AuthCommand}"
                  AutomationProperties.Name="{Binding Texts.AuthStart}"
                  ToolTip.Tip="{Binding Texts.AuthStart}"
                  Content="{Binding Texts.AuthStart}" />
          <Button Classes="refresh"
                  HorizontalAlignment="Left"
                  IsVisible="{Binding IsAuthRequired}"
                  Command="{Binding CheckAuthCommand}"
                  AutomationProperties.Name="{Binding Texts.AuthCheck}"
                  ToolTip.Tip="{Binding Texts.AuthCheck}"
                  Content="{Binding Texts.AuthCheck}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- The native client has a distinct unauthenticated surface.  Keep
         account-scoped values out of that surface instead of showing a grid
         full of unavailable placeholders while the user is signing in. -->
    <ScrollViewer Grid.Row="2" IsVisible="{Binding IsAuthenticated}" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14" HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="1.25*,*" ColumnSpacing="14">
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="{Binding Texts.RemainingQuota}" />
              <TextBlock FontSize="42" FontWeight="SemiBold" Text="{Binding RemainingPercentText}" />
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding RemainingPercentValue}" Height="8" IsVisible="{Binding HasQuota}" />
              <TextBlock Classes="label" Text="{Binding QuotaWindowText}" />
              <ItemsControl ItemsSource="{Binding QuotaSegments}" IsVisible="{Binding HasQuota}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="7" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:QuotaSegmentViewModel">
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fill}" Height="20" Margin="0,0,4,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="value" Text="{Binding QuotaRemainingText}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card">
            <StackPanel Spacing="9">
              <TextBlock Classes="label" Text="{Binding Texts.Account}" />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="7" ColumnSpacing="12">
                <TextBlock Classes="label" Text="{Binding Texts.Authentication}" />
                <TextBlock Grid.Column="1" Classes="value" Text="{Binding AuthenticationText}" />
                <TextBlock Grid.Row="1" Classes="label" Text="{Binding Texts.Plan}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding PlanText}" />
              </Grid>
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="card">
          <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="22">
              <StackPanel Spacing="3">
                <TextBlock Classes="label" Text="{Binding Texts.ResetTime}" />
                <TextBlock Classes="value" Text="{Binding ResetAtText}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Classes="label" Text="{Binding Texts.ObservedAt}" />
                <TextBlock Classes="value" Text="{Binding ObservedAtText}" />
              </StackPanel>
            </Grid>
            <TextBlock Grid.Row="1" Classes="label" Text="{Binding LastReceivedText}" />
          </Grid>
        </Border>

        <Border Classes="card">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="3">
              <TextBlock Classes="label" Text="{Binding Texts.RunningThreads}" />
              <TextBlock FontSize="22" FontWeight="SemiBold"
                         IsVisible="{Binding HasActiveThreads}"
                         Text="{Binding ActiveThreadCountLabel}" />
              <TextBlock Classes="label"
                         IsVisible="{Binding HasNoActiveThreads}"
                         Text="{Binding Texts.NoRunningThreads}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                        IsVisible="{Binding HasActiveThreads}"
                        VerticalAlignment="Center">
              <StackPanel Spacing="2"><TextBlock Classes="metric-label" Text="SOL" /><TextBlock Classes="metric-value" Text="{Binding ActiveSolCount}" /></StackPanel>
              <StackPanel Spacing="2"><TextBlock Classes="metric-label" Text="TERRA" /><TextBlock Classes="metric-value" Text="{Binding ActiveTerraCount}" /></StackPanel>
              <StackPanel Spacing="2"><TextBlock Classes="metric-label" Text="LUNA" /><TextBlock Classes="metric-value" Text="{Binding ActiveLunaCount}" /></StackPanel>
              <StackPanel Spacing="2"><TextBlock Classes="metric-label" Text="{Binding Texts.Other}" /><TextBlock Classes="metric-value" Text="{Binding ActiveOtherCount}" /></StackPanel>
              <Button Classes="refresh" Click="OnOpenThreads" AutomationProperties.Name="{Binding Texts.Details}" ToolTip.Tip="{Binding Texts.Details}" Content="{Binding Texts.Details}" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Classes="card models-section">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Texts.ModelUsage}" />
              <TextBlock Grid.Column="1" Classes="label" Text="{Binding ModelUsagePeriodText}" />
            </Grid>
            <TextBlock Classes="label" Text="{Binding Texts.ModelUsageDescription}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Classes="label" Text="{Binding DetailsStatusText}" />
                <TextBlock Grid.Column="1" Classes="label" Text="{Binding EstimatedCostText}" />
              </Grid>
            <TextBlock Classes="label" IsVisible="{Binding HasNoModels}" Text="{Binding ModelUsageUnavailableText}" />
            <ItemsControl IsVisible="{Binding HasModels}" ItemsSource="{Binding Models}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" ItemWidth="250" ItemHeight="106" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ModelUsageViewModel">
                  <Border Classes="model-card" Margin="0,0,12,0">
                    <StackPanel Spacing="3">
                      <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Name}" />
                      <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="2" ColumnSpacing="8">
                        <TextBlock Classes="metric-label" Text="{Binding InputLabel}" />
                        <TextBlock Grid.Column="1" Classes="metric-value" FontSize="13" Text="{Binding InputTokensText}" />
                        <TextBlock Grid.Column="2" Classes="metric-value" FontSize="13" Text="{Binding InputDollarsText}" />
                        <TextBlock Grid.Row="1" Classes="metric-label" Text="{Binding CachedInputLabel}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="metric-value" FontSize="13" Text="{Binding CachedInputTokensText}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Classes="metric-value" FontSize="13" Text="{Binding CachedInputDollarsText}" />
                        <TextBlock Grid.Row="2" Classes="metric-label" Text="{Binding OutputLabel}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="metric-value" FontSize="13" Text="{Binding OutputTokensText}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Classes="metric-value" FontSize="13" Text="{Binding OutputDollarsText}" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Row="3" Classes="label" Text="{Binding Texts.ConnectionEndpoint}" />
  </Grid>
</Window>
