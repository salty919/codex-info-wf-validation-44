# Install with: bash scripts/install_systemd_recorder.sh
# The default executable path is intentionally explicit.  The installer writes
# a drop-in when a different, validated absolute release-binary path is used.
# Do not run an untrusted copy.
[Unit]
Description=Codex Info local usage recorder
After=default.target
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/codex_info --record-daemon
ExecStartPre=%h/.local/bin/codex-info-recorder-cleanup
ExecStopPost=%h/.local/bin/codex-info-recorder-cleanup
Restart=on-failure
RestartSec=15s
KillSignal=SIGTERM
TimeoutStopSec=20s
Environment=CODEX_INFO_DAEMON_INTERVAL_SECS=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
